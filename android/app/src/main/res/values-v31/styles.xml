<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash is navy with the app icon, then the
         Flutter splash (1.1) takes over on the same navy. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_navy</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FFFFFF</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>
